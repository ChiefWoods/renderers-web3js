{
    "name": "renderers-web3js",
    "version": "0.2.2",
    "description": "Codama renderer for Web3.js",
    "keywords": [
        "framework",
        "renderers",
        "solana",
        "standard"
    ],
    "bugs": {
        "url": "http://github.com/ChiefWoods/renderers-web3js/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/ChiefWoods/renderers-web3js"
    },
    "files": [
        "./dist/types",
        "./dist/index.*"
    ],
    "type": "commonjs",
    "sideEffects": false,
    "main": "./dist/index.node.cjs",
    "module": "./dist/index.node.mjs",
    "browser": {
        "./dist/index.node.cjs": "./dist/index.browser.cjs",
        "./dist/index.node.mjs": "./dist/index.browser.mjs"
    },
    "types": "./dist/types/index.d.ts",
    "react-native": "./dist/index.react-native.mjs",
    "exports": {
        "types": "./dist/types/index.d.ts",
        "react-native": "./dist/index.react-native.mjs",
        "browser": {
            "import": "./dist/index.browser.mjs",
            "require": "./dist/index.browser.cjs"
        },
        "node": {
            "import": "./dist/index.node.mjs",
            "require": "./dist/index.node.cjs"
        }
    },
    "scripts": {
        "build": "rimraf dist && tsdown && tsc -p ./tsconfig.declarations.json",
        "dev": "vitest --project node",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "publish-package": "bun run build && changeset publish",
        "test": "bun run test:types && bun run build && bun run test:e2e && bun run test:generated && bun run test:unit && bun run test:exports",
        "test:e2e": "./test/e2e/test.sh",
        "test:exports": "node ./test/exports/module.mjs && node ./test/exports/commonjs.cjs",
        "test:generated": "vitest run test/generated/memo.test.ts test/generated/system.test.ts",
        "test:treeshakability": "for file in dist/index.*.mjs; do agadoo $file; done",
        "test:types": "tsc --noEmit -p ./tsconfig.typecheck.json",
        "test:unit": "vitest run test/fragments/accountType.test.ts test/fragments/definedType.test.ts test/fragments/instructionFunction.test.ts test/fragments/pdaFunction.test.ts test/fragments/programConstants.test.ts test/utils/importMap.test.ts test/utils/linkOverrides.test.ts test/visitors/getTypeVisitor.test.ts test/visitors/getValueVisitor.test.ts test/visitors/renderParentInstructions.test.ts"
    },
    "dependencies": {
        "@codama/errors": "^1.8.0",
        "@codama/nodes": "^1.8.0",
        "@codama/renderers-core": "^1.3.9",
        "@codama/visitors-core": "^1.8.0",
        "@solana/buffer-layout": "^4.0.1",
        "@solana/codecs": "^3.0.3",
        "@solana/web3.js": "3.0.0-rc.2",
        "oxfmt": "^0.60.0"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^0.5.1",
        "@changesets/cli": "^2.29.7",
        "@codama/cli": "^1.3.5",
        "@codama/nodes-from-anchor": "^1.5.1",
        "@solana-config/oxc": "^0.1.1",
        "@types/node": "^24",
        "agadoo": "^3.0.0",
        "happy-dom": "^19.0.1",
        "oxlint": "^1.75.0",
        "oxlint-tsgolint": "^7.0.2001",
        "rimraf": "6.0.1",
        "tsdown": "^0.22.13",
        "typescript": "^5.9.2",
        "vitest": "^3.2.4"
    },
    "browserslist": [
        "supports bigint and not dead",
        "maintained node versions"
    ],
    "engines": {
        "node": ">=24.18.0"
    },
    "packageManager": "bun@1.3.14"
}
